# Copy to .env.development / .env.production ON the host (never commit real values).
NODE_ENV=development
APP_ENV=development              # development | production (namespaces LiveKit rooms, cookies, logs)
HOST=127.0.0.1                   # always loopback; the tunnel/SSH forwarding provide access
PORT=3001                        # dev 3001, prod 3000
APP_PUBLIC_ORIGIN=http://localhost:3001   # prod: https://<public hostname>
DATABASE_URL=file:./data/dev/clocktower.db
SESSION_SECRET=change-me-64-hex-chars     # HMAC key for join tickets
PASSPHRASE_PEPPER=change-me-64-hex-chars  # HMAC key for passphrase lookup; rotating it invalidates all logins
COOKIE_SECURE=auto               # auto = Secure when origin is https
SESSION_TTL_DAYS=30
LOBBY_MAX_COUNT=4
PLAYER_MAX_PER_LOBBY=15
LOBBY_IDLE_TIMEOUT_SEC=600
RECONNECT_GRACE_SEC=300
ADMIN_ACCOUNT_IDS=               # comma-separated account ids allowed on /admin
LIVEKIT_URL=                     # wss://<project>.livekit.cloud ; empty => voice disabled gracefully
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_PREFIX=dev          # dev | prod — rooms are namespaced <prefix>-<lobbyId>-<zone>
VOICE_MONTHLY_MINUTES=5000
LOG_DIR=./logs/dev
