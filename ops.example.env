# Private operator settings for the scripts in scripts/ and deploy/ (copy to ops.local.env, which
# is gitignored, and fill in). Read by scripts/lib/ops-env.sh: KEY=VALUE lines only, CT_*/E2E_*
# keys only, no shell expansion. Variables already exported in your shell take precedence.
# Never commit real host names, tailnet names, IPs, user names or home paths.

# SSH alias (or user@host) of the build + production host — the machine that runs every
# install/build/test (scripts/remote.sh) and the dev/prod services (scripts/deploy-hshi-u1.sh).
CT_HOST=build-host

# `hostname` of that machine; host-only tests (tests/security/host-exposure.test.ts) run only there.
CT_HOST_NAME=build-host

# Public HTTPS origin of production (Cloudflare Tunnel). Used by smoke/verify scripts and the
# public e2e run; bootstrap uses its host part for prod APP_PUBLIC_ORIGIN.
CT_PUBLIC_URL=https://game.example.com
CT_PUBLIC_HOST=game.example.com
