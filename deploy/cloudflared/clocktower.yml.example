# Tunnel config on the host (lead-owned template; the hardened layout keeps it in /srv/clocktower/cloudflared/). Only the production port is
# routed; everything else returns 404 at the tunnel.
tunnel: <TUNNEL_UUID>
credentials-file: /srv/clocktower/cloudflared/<TUNNEL_UUID>.json
ingress:
  - hostname: clocktower.chrisshi.com
    service: http://127.0.0.1:3000
  - service: http_status:404
