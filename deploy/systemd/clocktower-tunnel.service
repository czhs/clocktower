# systemd --user unit (lead-owned): public ingress for PRODUCTION ONLY via Cloudflare Tunnel.
#   https://clocktower.chrisshi.com  ->  outbound tunnel from hshi-u1  ->  http://127.0.0.1:3000
# No inbound ports are opened on hshi-u1; the dev service (127.0.0.1:3001) is never referenced.
# Tunnel config + credentials live in ~/.cloudflared/ (chmod 600, never committed); see
# deploy/cloudflared/clocktower.yml.example and docs/deployment.md.
[Unit]
Description=Clocktower Town public ingress (Cloudflare Tunnel -> 127.0.0.1:3000)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/cloudflared --no-autoupdate tunnel --config %h/.cloudflared/clocktower.yml run
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clocktower-tunnel
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
