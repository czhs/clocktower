{
  "name": "clocktower-town",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @ct/server dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r run --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:load": "tsx tests/load/run.ts",
    "capture:tutorial": "CT_CAPTURE_TUTORIAL=1 playwright test -c tests/e2e/tutorial.config.ts --project capture",
    "serve": "node apps/server/dist/server.js",
    "assets:generate": "pnpm --filter @ct/assets generate",
    "db:migrate": "pnpm --filter @ct/db migrate"
  },
  "devDependencies": {
    "@colyseus/msgpackr": "1.11.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "colyseus.js": "~0.16.22",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "msgpackr-extract"]
  }
}
